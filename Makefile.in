       rpm2html.spec rpm2html.spec.in rpm2html.1 ChangeLog \
       msg.fr msg.es msg.de msg.pl msg.cz dir.png new.png \
       rpm2html.tpl \
       $(MAKE_FILES) $(CONFIG) $(RDF_FILES) $(FIND_FILES) $(USELESS)

